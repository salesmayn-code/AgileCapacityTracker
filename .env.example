# Copy to your shell profile or set per-session before running the backend (Spring does not read .env files directly)
# PowerShell example:
#   $env:SPRING_DATASOURCE_PASSWORD="your_db_password"
#   $env:JWT_SECRET="generate-a-random-32+-char-string"
#   $env:ADMIN_EMAIL="admin@example.com"
#   $env:ADMIN_PASSWORD="a-strong-password"

# ---- Backend (Spring Boot) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agile_capacity
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password
JWT_SECRET=change-me-to-a-random-32+-character-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
GITHUB_API_TOKEN=your_github_token
# Comma-separated allowed CORS origins (default: http://localhost:3000)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
# Set in frontend/.env.local. Server-side URL of the backend the BFF proxies to
# (never exposed to the browser - do not prefix with NEXT_PUBLIC_).
BACKEND_URL=http://localhost:8080
