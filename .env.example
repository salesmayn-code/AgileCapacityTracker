# Copy to your shell profile or set per-session before running the backend (Spring does not read .env files directly)
# PowerShell example:
#   $env:SPRING_DATASOURCE_PASSWORD="your_db_password"
#   $env:GITHUB_API_TOKEN="ghp_your_token_here"

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agile_capacity
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password
GITHUB_API_TOKEN=your_github_token
